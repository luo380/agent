OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3-1.7b
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LLM_TEMPERATURE=0

SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/agent_v1
DATABASE_SERVER_URL=mysql+pymysql://root:root@127.0.0.1:3306
DATABASE_NAME=agent_v1


RAG_CROSS_ENCODER_RERANK_ENABLED=1
RAG_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
RAG_CROSS_ENCODER_CANDIDATE_TOP_N=30
RAG_CROSS_ENCODER_BATCH_SIZE=16
RAG_CROSS_ENCODER_MODEL_WEIGHT=0.65
RAG_CROSS_ENCODER_RULE_WEIGHT=0.35


# ===== Semantic Chunking 真正的语义分块 =====
# USE_SEMANTIC_CHUNKING: 1=启用Embedding相似度边界检测(真语义), 0=启发式段落/句子/字符(旧版)
USE_SEMANTIC_CHUNKING=1
SEMANTIC_CHUNKING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_CHUNKING_BREAKPOINT_PERCENTILE=20
SEMANTIC_CHUNKING_BATCH_SIZE=32

# ===== Semantic Chunking LM Studio API 模式（强烈推荐） =====
# 原理：和 LLM / 入库 Embedding 一样走 LM Studio 的 OpenAI 兼容 /v1/embeddings
# 这样三套模型服务（LLM / 入库向量 / 分块向量）都由 LM Studio 统一管理
# 使用步骤：
#   1. 在 LM Studio 搜索下载并启动：text-embedding-paraphrase-multilingual-minilm-l12-v2.gguf
#   2. 打开下面的 USE_API=1；端口号与 OPENAI_BASE_URL 一致（默认 localhost:1234/v1）
# ✅ 2026-08-12 自动探测结果：模型名必须带 .gguf 后缀，embedding_dim=384
SEMANTIC_CHUNKING_USE_API=1
SEMANTIC_CHUNKING_API_MODEL=text-embedding-paraphrase-multilingual-minilm-l12-v2.gguf